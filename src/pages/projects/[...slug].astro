---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Status from '../../components/Status.astro';
import { getProjects } from '../../lib/collections';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.summary} type="article">
  <article class="wrap article">
    <header class="article__head">
      <p class="kicker mono">
        <a href="/projects/">Projects</a> <span class="sep" aria-hidden="true">/</span>
        <Status status={project.data.status} /> <span class="sep" aria-hidden="true">·</span>
        updated <FormattedDate date={project.data.updated} />
      </p>
      <h1 class="article__title">{project.data.title}</h1>
      <p class="article__dek">{project.data.summary}</p>
    </header>
    <div class="prose article__body">
      <Content />
    </div>
    {
      project.data.links.length > 0 && (
        <section class="links" aria-labelledby="links-title">
          <h2 id="links-title" class="kicker mono">Links</h2>
          <ul class="link-list">
            {project.data.links.map((l) => (
              <li>
                <a href={l.url}>{l.label} <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <footer class="article__foot mono">
      <a href="/projects/"><span aria-hidden="true">←</span> All projects</a>
    </footer>
  </article>
</Base>
