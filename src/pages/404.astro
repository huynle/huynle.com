---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist." noindex>
  <header class="wrap page-head page-head--404">
    <p class="kicker mono">Error 404</p>
    <h1 class="page-head__title">This page isn't in the notebook.</h1>
    <p class="page-head__lede">
      The site was rebuilt from scratch in 2026 and older pages were not carried over. Try the
      <a href="/">front page</a>, the <a href="/posts/">writing archive</a>, or the <a href="/projects/">project index</a>.
    </p>
  </header>
</Base>
